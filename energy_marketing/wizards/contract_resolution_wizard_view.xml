<odoo>
	<record id="contract_resolution_wizard_form_view" model='ir.ui.view'>
		<field name="name">contract.resolution.wizard.form.view</field>
		<field name="model">contract.resolution.wizard</field>
		<field name="arch" type="xml">
			<form>
				<group cols="2">
                    <field name="description"/>
                    <field name="contract" invisible="1"/>
				</group>
				<footer>
					<button type="object" class="oe_highlight" name="generate_resolution">
		        			Accept
					</button>
					<button string="Cancel" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

    <record id="energy_action_contract_resolution_wizard" model="ir.actions.act_window">
        <field name="name">Energy contract incidence resolution wizard</field>
        <field name="res_model">contract.resolution.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
	</record>
</odoo>