<odoo>
	<record id='energy_contract_incidence_tree_view' model='ir.ui.view'>
		<field name="name">energy.contract.incidence.tree.view</field>
        <field name="model">energy.contract.incidence</field>
        <field name="arch" type="xml">
        	<tree create='0' delete='0'>
        		<field name="name"/>
            	<field name="contract"/>
                <field name="contract_state"/>
                <field name="partner"/>
                <field name="salesperson"/>
                <field name="state" widget="badge" 
									decoration-warning="state == 'no_resolution'" 
                                    decoration-info="state == 'open'"
                />
        	</tree>
        </field>
	</record>
	
	<record id='energy_contract_incidence_form_view' model='ir.ui.view'>
		<field name="name">energy.contract.incidence.form.view</field>
        <field name="model">energy.contract.incidence</field>
        <field name="arch" type="xml">
        	<form create='0' delete='0' edit='0'>
                <header>
        			<field name="state" widget="statusbar" readonly="1"/>
                </header>
        		<sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="contract"/>
                            <field name="contract_state"/>
                        </group>
                        <group>
                            <field name="partner"/>
                            <field name="salesperson"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Resolution">
                            <field name="resolution"/>
                        </page>
                    </notebook>
                </sheet>
        		<div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
        	</form>
        </field>
	</record>
	
	<record id="energy_contract_incidence_search_view" model="ir.ui.view">
			<field name="name">energy.contract.incidence.search.view</field>
			<field name="model">energy.contract.incidence</field>
			<field name="arch" type="xml">
				<search string="Incidences">
                    <field name="name"/>
                    <field name="contract"/>
                    <field name="contract_state"/>
                    <field name="partner"/>
                    <field name="salesperson"/>
				</search>
			</field>
	</record>
	
</odoo>