<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="module_energy_marketing" model="ir.module.category" >
      <field name="name">Energy Marketing</field>
      <field name="description">Energy marketing system security.</field>
      <field name="sequence">9</field>
    </record>

      <record id="group_energy_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_energy_marketing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

      <record id="group_energy_manager" model="res.groups">
        <field name="name">Energy Administrator</field>
        <field name="category_id" ref="module_energy_marketing"/>
        <field name="implied_ids" eval="[(4, ref('group_energy_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

  </data>
</odoo>